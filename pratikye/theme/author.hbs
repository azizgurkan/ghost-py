<div class="archive author-archive">
    <header class="archive-head">
        <p class="section-eyebrow">Yazar</p>
        <h1>{{name}}</h1>
        {{#if bio}}
            <p class="archive-copy">{{bio}}</p>
        {{/if}}
        <p class="archive-meta">{{pagination.total}} tarif</p>
    </header>

    <div class="card-grid">
        {{#foreach posts}}
            {{> "recipe-card"}}
        {{/foreach}}
    </div>

    {{> "pagination"}}
</div>
